{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@flightbrain/domain": ["packages/domain/src/index.ts"],
      "@flightbrain/composer": ["packages/composer/src/index.ts"],
      "@flightbrain/discovery": ["packages/discovery/src/index.ts"],
      "@flightbrain/providers": ["packages/providers/src/index.ts"],
      "@flightbrain/ranking": ["packages/ranking/src/index.ts"],
      "@flightbrain/orchestrator": ["packages/orchestrator/src/index.ts"],
      "@flightbrain/search-api": ["packages/search-api/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "demo/**/*.ts",
    "vitest.config.ts"
  ]
}
